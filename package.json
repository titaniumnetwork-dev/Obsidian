{
  "name": "obsidian",
  "author": "Nebelung",
  "description": "Play instantly. No downloads.",
  "version": "1.1.3",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "local": "vite dev --mode offline --open",
