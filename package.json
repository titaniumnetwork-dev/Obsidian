    "@lucide/svelte": "^1.72.0",
    "@ruffle-rs/ruffle": "0.6.0",
    "@uiw/codemirror-extensions-color": "^4.25.12",
    "jszip": "^3.10.2",
    "mathjs": "^15.2.0",
    "svelte-codemirror-editor": "^2.1.0",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^3.7.0",
