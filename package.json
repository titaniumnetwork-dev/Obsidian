  "devDependencies": {
    "@inlang/cli": "^3.4.5",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8",
    "wrangler": "^4.160.0"
  },
  "dependencies": {
    "7zip-min": "^3.0.1",
    "@babel/runtime": "^8.0.10",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/view": "^6.43.15",
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@icons-pack/svelte-simple-icons": "^7.2.0",
