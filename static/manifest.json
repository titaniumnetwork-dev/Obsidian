{
  "id": "obsidian",
  "name": "Obsidian",
  "description": "Play instantly. No downloads.",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "orientation": "landscape",
  "background_color": "#0a0a0a",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    {
      "src": "/assets/logo-180.png",
      "type": "image/png",
      "sizes": "180x180"
    },
    {
      "src": "/assets/logo-192.png",
      "type": "image/png",
      "sizes": "192x192"
    },
    {
      "src": "/assets/logo-512.png",
      "type": "image/png",
      "sizes": "512x512"
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "url": "/library",
      "icons": [
        {
          "src": "/assets/library-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Store",
      "url": "/store",
      "icons": [
        {
          "src": "/assets/store-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Emulation",
      "url": "/emulation",
      "icons": [
        {
          "src": "/assets/emulation-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Settings",
      "url": "/settings",
      "icons": [
        {
          "src": "/assets/settings-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/screenshot_home.png",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The Obsidian homepage"
    },
    {
      "src": "/assets/screenshot_slope.png",
      "sizes": "1280x720",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Slope store page"
    }
  ]
}
