{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obsidian",
  "compatibility_date": "2026-10-02",
  "pages_build_output_dir": ".svelte-kit/cloudflare",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 50
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "files",
      "remote": true
    }
  ]
}
